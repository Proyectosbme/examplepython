# .env.example — PLANTILLA de credenciales (este archivo SÍ va a git, sin datos reales)
# Para usarlo: copiarlo como ".env" y llenar los valores reales.
# El ".env" NO se sube a git (está en .gitignore).

# ---------- Base 1: servidor sqlqa1 ----------
DB1_SERVER=sqlqa1
DB1_PORT=1433
DB1_NAME=Clientes
DB1_USER=etl_user
DB1_PASSWORD=cambiar_esto
# Si el servidor usa instancia con nombre (sqlqa1\SQLEXPRESS), poner aquí el nombre y dejar el puerto vacío:
DB1_INSTANCE=

# ---------- Base 2: servidor sqlqa2 ----------
DB2_SERVER=sqlqa2
DB2_PORT=1433
DB2_NAME=Finanzas
DB2_USER=etl_user
DB2_PASSWORD=cambiar_esto
DB2_INSTANCE=
